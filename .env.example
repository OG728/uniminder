# Copy this file to .env and fill in your own values. Never commit .env.

# Your school's Canvas site
CANVAS_BASE_URL=https://YOUR_SCHOOL.instructure.com
# Canvas > Account > Settings > New Access Token
CANVAS_ACCESS_TOKEN=your_token_here

# Where your synced data is saved (fine to leave as is)
DATABASE_URL=sqlite:///./data/uni_reminder.db
# How often it re-syncs in the background, in minutes
SYNC_INTERVAL_MINUTES=30

# Study plans: rules (no AI), ollama (local model), or api (AI API key)
PLANNER_BACKEND=rules

# Only used when PLANNER_BACKEND=ollama. Use the name from `ollama list`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Only used when PLANNER_BACKEND=api. Leave AI_BASE_URL as is for OpenAI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
